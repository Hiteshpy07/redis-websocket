{
  "manifest_version": 3,
  "name": "Co-Sketch",
  "version": "1.0.0",
  "description": "Real-time collaborative sketching and whiteboard.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Co-Sketch",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://co-sketch.onrender.com/*",
    "wss://co-sketch.onrender.com/*",
    "https://*.google.com/*",
    "https://*.github.com/*"
  ]
}
