{
  "manifest_version": 3,
  "name": "Co-Sketch",
  "version": "1.0.0",
  "description": "Real-time collaborative sketching and whiteboard.",
  "action": {
    "default_title": "Open Co-Sketch"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "identity",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://co-sketch.onrender.com/*",
    "wss://co-sketch.onrender.com/*",
    "https://*.google.com/*",
    "https://*.github.com/*"
  ]
}
